# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# ── Required ─────────────────────────────────────────────────────────────────

do_token            = "dop_v1_<your-digitalocean-api-token>"
ssh_key_fingerprint = "aa:bb:cc:dd:ee:ff:..."   # `doctl compute ssh-key list`
wildcard_hostname   = "broch.example.com"

# DNS provider for Caddy's wildcard cert (DNS-01 challenge).
# digitalocean, cloudflare (default), and godaddy are supported (single-token DNS-01 providers) --
# digitalocean is the natural pick if your DNS zone is on DigitalOcean too. Route 53 needs an AWS key
# PAIR, not a single token, so it is NOT supported here -- use the aws-vm/azure-vm appliance for it.
dns_provider        = "cloudflare"
dns_api_token       = "<your-dns-provider-api-token>"

# Identity provider — required at boot. Broch has no built-in local login, so the
# IdP is part of the boot floor; the plan refuses a combination Broch would refuse
# at startup. Your first admin signs in holding a role named in admin_roles
# (named admin_roles here, not auth_admin_roles as in the other Terraform modules).
# Guides: https://broch.io/docs/identity-providers/
auth_provider       = "AzureAd"         # Auth0 | AzureAd | EntraExternalId | Okta | Oidc
auth_client_id      = "<idp-application-id>"
auth_client_secret  = "<idp-client-secret>"
admin_roles         = "broch_admin"

# Set the value(s) your provider needs; leave the rest unset:
#   AzureAd:          auth_tenant_id = "..."  (auth_instance defaults to https://login.microsoftonline.com/)
#   EntraExternalId:  auth_tenant_id = "..."  +  auth_instance = "https://<tenant>.ciamlogin.com/"
#   Auth0:            auth_domain    = "your-tenant.auth0.com"  +  auth_audience = "<your-auth0-api-identifier>"
#   Okta:             auth_domain    = "your-org.okta.com"
#   Oidc (generic):   auth_authority = "https://issuer.example.com"
auth_tenant_id      = "<azure-tenant-id>"       # AzureAd / EntraExternalId only; remove for other providers

# NOTE: the bundled Postgres password is NOT set here — it is generated on the droplet at
# first boot and stored in /opt/broch/.env (kept out of droplet user_data). Nothing to fill in.

# ── Optional (defaults shown) ────────────────────────────────────────────────

# region              = "nyc3"
# droplet_size        = "s-1vcpu-1gb"
# deployment_name     = "broch-server"
# volume_size         = 10
# image               = "ghcr.io/broch-io/broch"
# image_tag           = "1.35.0"   # defaults to a pinned version; set a newer tag to upgrade, or "latest" to float
# auth_provider       = "AzureAd"
# auth_instance       = ""   # AzureAd defaults to https://login.microsoftonline.com/; EntraExternalId: https://<tenant>.ciamlogin.com/
# ssh_allowed_cidrs   = ["203.0.113.0/24"]   # break-glass SSH; default [] = no port-22 rule
